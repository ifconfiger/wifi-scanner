<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>zh-Hans</string>
    </array>
    <key>CFBundleName</key>
    <string>WiFi-Scanner</string>
    <key>CFBundleDisplayName</key>
    <string>WiFi-Scanner</string>
    <key>CFBundleExecutable</key>
    <string>WiFiScanner</string>
    <!-- Kept from the WiFiScope days: changing it would reset location permission and settings and break updates -->
    <key>CFBundleIdentifier</key>
    <string>com.local.wifiscope</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.4.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- macOS 14+ requires location authorization to read SSID/BSSID; otherwise CoreWLAN returns nil.
         Localized in Resources/*.lproj/InfoPlist.strings -->
    <key>NSLocationUsageDescription</key>
    <string>macOS requires location permission before apps can read the names (SSID) and BSSIDs of nearby Wi-Fi networks. WiFi-Scanner never records or uploads your location.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>macOS requires location permission before apps can read the names (SSID) and BSSIDs of nearby Wi-Fi networks. WiFi-Scanner never records or uploads your location.</string>
</dict>
</plist>
